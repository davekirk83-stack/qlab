//@version=6
// DELTA / CVD — BTC (DK 7 Nov 2026, Monday desk pack). Lower pane.
// Estimates buying vs selling inside each bar from 1-minute pieces (TradingView Essential has no seconds data and no taker-side volume):
// each 1-minute piece adds volume x (close - open) / (high - low). Checked against Binance's TRUE taker delta (May-Nov 2026): it agrees in
// sign about 74% of the time (correlation ~0.68) on 5-min to 1-hour bars. Good enough to see who is pushing; not exact.
//   BARS    delta per bar (green = net buying, red = net selling); LINE = cumulative delta (CVD), reset each UTC day / week / never.
//   STRESS  shaded background = BTC has moved >= 3x its normal 24h move in the last 24h. 'STRESS LOW' = a new 4-hour low inside a
//           down-stress move. CONTEXT, not a buy signal: counted once per episode (BTC 2020-26) it returned -0.15% / +0.06% over the next
//           4h in the two test periods; above the 99-day line ~0 / +0.10%, below it negative in both. (The +0.26-0.35% first quoted in
//           doc 191 counted every bar of the same panic separately — corrected 9 Nov.) The doc 191 ladder's small edge came from
//           buying several of these with a +3% target, above the 99-day line only.
//   ABS     absorption: heavy selling (delta z <= -2.5 vs the last ~4 days) but the bar closes in the top 40% of its range, at a 4h low.
//           With TRUE delta it added ~+20bp on top of a stress low; with this chart's ESTIMATED delta the same marker was unreliable
//           (one test period negative). Treat ABS as colour, not a signal. Mirror at highs; shorting stress highs did NOT work (doc 191).
//   DIV     CVD divergence (new 4h low, CVD higher than at the previous low within a day). Tested: no edge on its own. Context only.
indicator("Delta / CVD - BTC", shorttitle="Delta CVD", overlay=false, max_labels_count=200)

string resetMode = input.string("Day (UTC)", "CVD resets", options=["Day (UTC)", "Week", "Never"])
string ltf       = input.timeframe("1", "Pieces (lower timeframe)")
float  zAbs      = input.float(2.5, "Absorption: delta z at or beyond", step=0.1)
float  posAbs    = input.float(0.6, "Absorption: close at or beyond this share of the bar", step=0.05)
float  stressK   = input.float(3.0, "Stress: 24h move at least x its 30-day median", step=0.25)
bool   showDiv   = input.bool(true, "Mark CVD divergences")

color cUp = #26a69a
color cDn = #ef5350
color cAbs = #ffd54f

// ---------------- delta from 1-minute pieces ----------------
[ltfO, ltfH, ltfL, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltf, [open, high, low, close, volume])
float d = 0.0
int n = array.size(ltfC)
if n > 0
    for i = 0 to n - 1
        float o = array.get(ltfO, i)
        float c = array.get(ltfC, i)
        float v = array.get(ltfV, i)
        float h = array.get(ltfH, i)
        float l = array.get(ltfL, i)
        d += h > l ? v * (c - o) / (h - l) : 0.0
else
    d := high > low ? volume * (close - open) / (high - low) : 0.0

// ---------------- CVD ----------------
bool newPeriod = resetMode == "Day (UTC)" ? ta.change(time("D")) != 0 : resetMode == "Week" ? ta.change(time("W")) != 0 : false
var float cvd = 0.0
cvd := newPeriod ? d : cvd + d

// ---------------- absorption and stress ----------------
int barsPer4h = math.max(1, int(math.round(4 * 3600 / timeframe.in_seconds())))
int barsPer4d = math.min(4000, math.max(20, int(math.round(4 * 86400 / timeframe.in_seconds()))))
int barsPer1d = math.max(1, int(math.round(86400 / timeframe.in_seconds())))
float dMean = ta.sma(d, barsPer4d)[1]
float dStd  = ta.stdev(d, barsPer4d)[1]
float z = dStd > 0 ? (d - dMean) / dStd : na
float rng = high - low
float posUp = rng > 0 ? (close - low) / rng : 0.5
bool at4hLow  = low <= ta.lowest(low, barsPer4h)
bool at4hHigh = high >= ta.highest(high, barsPer4h)
float typ = request.security(syminfo.tickerid, "D", ta.median(math.abs(close / close[1] - 1), 30)[1], lookahead=barmerge.lookahead_on)
float r24 = close / close[barsPer1d] - 1
bool stressDn = not na(typ) and r24 <= -stressK * typ
bool stressUp = not na(typ) and r24 >= stressK * typ
bool absLow  = barstate.isconfirmed and at4hLow and not na(z) and z <= -zAbs and posUp >= posAbs
bool absHigh = barstate.isconfirmed and at4hHigh and not na(z) and z >= zAbs and posUp <= 1 - posAbs

// ---------------- CVD divergence (new 4h low, CVD higher than at the previous low within a day) ----------------
var float lastLowPx = na
var float lastLowCvd = na
var int   lastLowBar = na
var float lastHighPx = na
var float lastHighCvd = na
var int   lastHighBar = na
bool divBull = false
bool divBear = false
if barstate.isconfirmed and at4hLow
    if not na(lastLowPx) and bar_index - lastLowBar >= barsPer4h and bar_index - lastLowBar <= barsPer1d and low < lastLowPx and cvd > lastLowCvd
        divBull := true
    lastLowPx := low
    lastLowCvd := cvd
    lastLowBar := bar_index
if barstate.isconfirmed and at4hHigh
    if not na(lastHighPx) and bar_index - lastHighBar >= barsPer4h and bar_index - lastHighBar <= barsPer1d and high > lastHighPx and cvd < lastHighCvd
        divBear := true
    lastHighPx := high
    lastHighCvd := cvd
    lastHighBar := bar_index

// ---------------- plots ----------------
plot(d, "Delta", style=plot.style_columns, color=d >= 0 ? color.new(cUp, 30) : color.new(cDn, 30))
plot(cvd, "CVD", color=color.new(#e6edf3, 0), linewidth=2)
hline(0, "Zero", color=color.new(#8b949e, 60))
bool stressLow = barstate.isconfirmed and at4hLow and stressDn
plotshape(stressLow, "STRESS LOW (tested edge)", style=shape.diamond, location=location.bottom, color=color.new(#ffd54f, 0), size=size.tiny, text="STRESS LOW", textcolor=#ffd54f)
plotshape(absLow and stressDn, "Absorption at a STRESS low", style=shape.triangleup, location=location.bottom, color=cAbs, size=size.small, text="ABS", textcolor=cAbs)
plotshape(absLow and not stressDn, "Absorption at a low", style=shape.triangleup, location=location.bottom, color=color.new(cAbs, 50), size=size.tiny, text="ABS", textcolor=color.new(cAbs, 50))
plotshape(absHigh and stressUp, "Absorption at a STRESS high", style=shape.triangledown, location=location.top, color=cAbs, size=size.small, text="ABS", textcolor=cAbs)
plotshape(absHigh and not stressUp, "Absorption at a high", style=shape.triangledown, location=location.top, color=color.new(cAbs, 50), size=size.tiny, text="ABS", textcolor=color.new(cAbs, 50))
plotshape(showDiv and divBull, "CVD bullish divergence", style=shape.circle, location=location.bottom, color=color.new(cUp, 0), size=size.tiny, text="DIV", textcolor=cUp)
plotshape(showDiv and divBear, "CVD bearish divergence", style=shape.circle, location=location.top, color=color.new(cDn, 0), size=size.tiny, text="DIV", textcolor=cDn)
bgcolor(stressDn ? color.new(cDn, 92) : stressUp ? color.new(cUp, 92) : na, title="Stress move (24h)")

alertcondition(stressLow, "STRESS LOW", "Delta CVD: new 4h low inside a down-stress move (doc 191 edge) {{ticker}} {{interval}}")
alertcondition(absLow and stressDn, "Absorption at a STRESS low", "Delta CVD: absorption at a stress low {{ticker}} {{interval}}")
alertcondition(absHigh and stressUp, "Absorption at a STRESS high", "Delta CVD: absorption at a stress high {{ticker}} {{interval}}")
alertcondition(absLow, "Absorption at a low (any)", "Delta CVD: absorption at a 4h low {{ticker}} {{interval}}")
alertcondition(divBull, "CVD bullish divergence", "Delta CVD: bullish divergence {{ticker}} {{interval}}")
